# EAGLEYE Autopilot — copy to .env.local. Every key is optional:
# a missing key switches that engine to demo mode.

# Editorial brain (brand kit, weekly plan, captions)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Images and videos (same gateway as Open Generative AI)
MUAPI_API_KEY=
AUTOPILOT_IMAGE_MODEL=nano-banana-2
AUTOPILOT_VIDEO_MODEL=seedance-v2.0-t2v

# Publishing (Postiz cloud or self-hosted)
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com/public/v1

# Persistence + auth (Supabase). Leave both empty to keep the current
# behaviour (localStorage, no login). Set both to switch Autopilot over to
# Postgres + magic-link auth for the EAGLEYE team:
#   1. Create a project at supabase.com, run supabase/migrations/0001_autopilot_init.sql
#      against it (SQL editor, or `supabase db push`).
#   2. In Authentication > Providers, keep Email enabled (magic link, no
#      password) and disable public sign-ups if you don't want a sign-up
#      page — invite teammates from Authentication > Users instead.
#   3. Copy the Project URL and the anon public key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Encrypts the Anthropic/MuAPI/Postiz keys at rest in the api_credentials
# table (AES-256-GCM). Generate with: openssl rand -base64 32
# Required only once NEXT_PUBLIC_SUPABASE_URL is set.
AUTOPILOT_CREDENTIALS_KEY=
